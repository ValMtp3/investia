# Investia — variables d'environnement (exemple sans valeurs, D42).
# Copier en .env et remplir localement. .env est gitignoré.

# Infra (requis) — hostnames = noms de services Docker (compose depuis deploy/)
# POSTGRES_USER est le compte ADMIN (superuser) : réservé au conteneur backup (pg_dump)
# et au healthcheck. Les services applicatifs utilisent les rôles sans SUPERUSER
# ci-dessous (D68). Générer chaque mot de passe avec : openssl rand -hex 32
POSTGRES_USER=investia
POSTGRES_PASSWORD=
# Rôles applicatifs (D68) : investia_app possède la base investia (backend + Alembic),
# litellm_app possède la base litellm. Créés à la création du volume PostgreSQL ;
# sur un volume existant : sh deploy/postgres/apply-app-roles.sh (une fois).
INVESTIA_APP_DB_PASSWORD=
LITELLM_APP_DB_PASSWORD=
# Authelia (D50) — requis en prod, facultatif en local. Générer chaque valeur avec : openssl rand -hex 32
# AUTHELIA_DB_PASSWORD est créé dans PostgreSQL à la première création du volume, puis lu par
# Authelia : si le volume existe déjà, le changer ici ne change pas le mot de passe en base.
AUTHELIA_DB_PASSWORD=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_JWT_SECRET=
# Ports loopback (127.0.0.1 uniquement, jamais 0.0.0.0) exposés au Nginx Proxy Manager, qui tourne
# en network_mode: host sur le VPS (D54) et atteint donc la pile via localhost. Laisser les
# défauts sauf si le port est déjà pris sur le VPS (vérifier avec : ss -tlnp).
DASHBOARD_LOOPBACK_PORT=8080
AUTHELIA_LOOPBACK_PORT=9092
# Secret partagé NPM -> dashboard (D53) : NPM l'envoie dans l'en-tête X-Edge-Secret, le nginx du
# dashboard refuse (403) toute requête sans lui. Requis en prod, laisser vide en local.
EDGE_SECRET=
# Connexions applicatives : rôles sans SUPERUSER (D68), pas le compte admin.
DATABASE_URL=postgresql+asyncpg://investia_app:CHANGE_ME@postgres:5432/investia
LITELLM_DATABASE_URL=postgresql://litellm_app:CHANGE_ME@postgres:5432/litellm
REDIS_URL=redis://redis:6379/0
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=
# APP_SECRET_KEY : jeton admin (X-Admin-Token, D51). 32 caractères minimum, sinon le backend
# refuse de démarrer. Générer avec : openssl rand -hex 32
APP_SECRET_KEY=

# Fournisseurs LLM (D43 : OpenRouter pour GPT+Jev, Mistral direct pour Mistral)
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
FINNHUB_API_KEY=
EODHD_API_KEY=
TWELVEDATA_API_KEY=
MASSIVE_API_KEY=
COINGECKO_DEMO_API_KEY=
STOOQ_API_KEY=
BRAVE_API_KEY=
NUTRIENT_API_KEY=
