# Investia — variables d'environnement (exemple sans valeurs, D42).
# Copier en .env et remplir localement. .env est gitignoré.

# Infra (requis) — hostnames = noms de services Docker (compose depuis deploy/)
POSTGRES_USER=investia
POSTGRES_PASSWORD=
# Authelia (D50) — requis en prod, facultatif en local. Générer chaque valeur avec : openssl rand -hex 32
# AUTHELIA_DB_PASSWORD est créé dans PostgreSQL à la première création du volume, puis lu par
# Authelia : si le volume existe déjà, le changer ici ne change pas le mot de passe en base.
AUTHELIA_DB_PASSWORD=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_JWT_SECRET=
# Nom du réseau Docker de Nginx Proxy Manager sur le VPS (voir `docker network ls`). Requis en prod.
# Pas un secret : un simple nom, par exemple le réseau créé par le compose de NPM.
NPM_NETWORK_NAME=
# Secret partagé NPM -> dashboard (D53) : NPM l'envoie dans l'en-tête X-Edge-Secret, le nginx du
# dashboard refuse (403) toute requête sans lui. Requis en prod, laisser vide en local.
EDGE_SECRET=
DATABASE_URL=postgresql+asyncpg://investia:CHANGE_ME@postgres:5432/investia
LITELLM_DATABASE_URL=postgresql://investia:CHANGE_ME@postgres:5432/litellm
REDIS_URL=redis://redis:6379/0
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=
# APP_SECRET_KEY : jeton admin (X-Admin-Token, D51). 32 caractères minimum, sinon le backend
# refuse de démarrer. Générer avec : openssl rand -hex 32
APP_SECRET_KEY=

# Fournisseurs LLM (D43 : OpenRouter pour GPT+Jev, Mistral direct pour Mistral)
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
FINNHUB_API_KEY=
EODHD_API_KEY=
TWELVEDATA_API_KEY=
MASSIVE_API_KEY=
COINGECKO_DEMO_API_KEY=
STOOQ_API_KEY=
